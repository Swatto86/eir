[api]
# Four CLI providers: "opencode_cli", "claude_cli", "codex_cli", "cursor_cli".
# Everything here is editable in the app's Settings panel — no need to touch
# this file after install. Legacy provider names (openrouter, anthropic, kilo_cli,
# ollama, …) still load and map onto OpenCode or Claude CLI.

# ── Option A (default): OpenCode CLI — cloud models or local Ollama ───────────
# Uses the logged-in `opencode` CLI. No API key is pasted into Eir.
# Local models use the `ollama/<name>` form (pull first with `ollama pull`).
# Cloud models use `provider/model` as listed by `opencode models`.
provider = "opencode_cli"
model = "ollama/llama3.2"   # required — e.g. ollama/… or anthropic/claude-sonnet-4-6
# opencode_cli_path = ""              # optional — blank = auto-detect
# opencode_cli_user_profile = ""      # optional — blank = auto-detect

# Model for the on-demand app-update check. Blank = the main model.
# OpenCode / Claude / Codex use their built-in web search where available.
update_check_model = ""

# Reasoning effort: low|medium|high|xhigh|max (blank = provider default).
# Claude CLI → --effort; Codex CLI → model_reasoning_effort;
# OpenCode CLI → --variant; Cursor CLI has no effort dial.
effort = ""

# ── Option B: Claude via your subscription (Claude CLI — no API key) ──────────
# Uses the machine's logged-in `claude` session; nothing is billed beyond your
# Claude plan. Leave user_profile and claude_cli_path blank to auto-detect them.
# The service launches the CLI with the active desktop user's Windows token,
# never with LocalSystem authority.
# provider = "claude_cli"
# model = ""   # blank = the CLI's configured default, or e.g. "sonnet" / "claude-opus-4-8"
# user_profile = "C:\\Users\\YourName"                              # optional override
# claude_cli_path = "C:\\Users\\YourName\\.local\\bin\\claude.exe"  # optional override

# ── Option C: Codex via your ChatGPT subscription (Codex CLI — no API key) ────
# Uses the active desktop user's logged-in `codex` session. Run `codex login`
# once; Eir finds codex.exe under that profile and launches it with that user's
# Windows token (never with LocalSystem authority).
# provider = "codex_cli"
# model = ""   # blank = the CLI default, or e.g. "gpt-5.6-terra"
# codex_cli_path = "C:\\Users\\YourName\\.codex\\packages\\standalone\\current\\bin\\codex.exe"

# ── Option D: Cursor via the `agent` CLI (Cursor subscription — no API key) ───
# Uses the logged-in Cursor agent CLI. Install it and run `agent login` once.
# provider = "cursor_cli"
# model = ""   # blank = CLI default, or e.g. "auto" / "composer-2.5"
# cursor_cli_path = ""            # optional — blank = auto-detect `agent`
# cursor_cli_user_profile = ""    # optional — blank = auto-detect

[monitoring]
decision_interval_secs = 600
event_log_poll_interval_secs = 30
wmi_poll_interval_secs = 300
confidence_threshold = 0.80
# event_log_channels = ["System", "Application"]
# log_directories = []
game_mode_auto = true
game_mode_power_boost = true
# Idle (no AI analysis, updater or digest) while the tray app is closed; resume when it
# opens. Set false for a headless PC that should self-heal unattended.
require_tray = true

[advisor]
enabled = false
# escalation_model = ""
# escalation_effort = "high"
low_confidence_threshold = 0.6

[updater]
enabled = true
interval_secs = 86400
# max_apps_per_run = 20
# max_attempts_per_app = 2

[persistence]
# SQLite audit database (relative to the install / portable state directory).
audit_db = "eir.db"
