diff --git a/Cargo.toml b/Cargo.toml
index f48e532..28adf5b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -37,6 +37,9 @@ ammonia = "4"
 
 # Release profile lives at the workspace root (member profiles are ignored).
 # Tuned for a small, fast binary — the AllTheThings recipe.
+[profile.dev.package."*"]
+opt-level = 1
+
 [profile.release]
 codegen-units = 1
 lto = true
diff --git a/scripts/fastcheck.sh b/scripts/fastcheck.sh
new file mode 100755
index 0000000..1c572e7
--- /dev/null
+++ b/scripts/fastcheck.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Fast per-edit check: formatting and type correctness, no test run or Tauri bundle.
+# Pass -p wattmail-domain (or another workspace crate) for scoped cargo check.
+# scripts/verify.sh is the full gate before a commit.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+export PATH="$HOME/.cargo/bin:$PATH"
+
+PACKAGE=""
+while getopts "p:" opt; do
+  case "$opt" in
+    p) PACKAGE="$OPTARG" ;;
+    *) exit 2 ;;
+  esac
+done
+
+npm run build
+cargo fmt --all -- --check
+
+if [ -n "$PACKAGE" ]; then
+  echo "==> cargo check -p $PACKAGE"
+  cargo check --locked -p "$PACKAGE" --all-targets
+else
+  echo "==> cargo clippy"
+  cargo clippy --all-targets -- -D warnings
+fi
+
+echo "fastcheck OK"
